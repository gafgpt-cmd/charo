#!/bin/sh
set -eu
service=hyprwhspr-on-demand.service
if ! systemctl --user --quiet is-active "$service"; then
    systemctl --user start "$service"
fi

i=0
while [ "$i" -lt 120 ]; do
    output=$(/home/toni/.local/share/hyprwhspr/src/bin/hyprwhspr record toggle "$@" 2>&1) || true
    case "$output" in
        *'[SUCCESS]'*) printf '%s\n' "$output"; exit 0 ;;
    esac
    sleep 0.25
    i=$((i + 1))
done

printf '%s\n' "$output" >&2
printf '%s\n' 'Dictation did not become ready. Check: journalctl --user -u hyprwhspr-on-demand -n 50' >&2
exit 1
