#!/bin/sh
# charo - dictation for XFCE, driving hyprwhspr from the keyboard and tray.
#
#   charo record            toggle recording (starts the engine if needed)
#   charo power             toggle the engine on or off
#   charo on | off          load or unload the engine explicitly
#   charo engine            print the engine in use
#   charo engine switch     swap between Parakeet and Whisper
#   charo engine parakeet   use Parakeet (auto-detects 25 EU languages)
#   charo engine whisper    use faster-whisper (99 languages, adds Catalan)
#   charo tv                toggle TV mode (stop reacting to wake words)
#   charo tv on|off|status  set or query TV mode
#   charo keys              show the keyboard shortcuts and what they do
#   charo state             machine-readable: off | idle | recording
#   charo status            human-readable status
#
# TV mode exists because dictation normally sits idle listening for a spoken
# start phrase, and a television will happily say it. Turning TV mode on parks
# those wake words - saved and restored, never lost - so dictation starts only
# from the key or the tray.
#
# When stdout is not a terminal (hotkeys, tray menu) results are reported as
# desktop notifications instead of printed.
set -eu

service="hyprwhspr-on-demand.service"
hyprwhspr="$HOME/.local/share/hyprwhspr/src/bin/hyprwhspr"
runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hyprwhspr"
config="$HOME/.config/hyprwhspr/config.json"
wakewords="$HOME/.local/share/charo/wake-words.json"
recording_start_icon="$HOME/.local/share/charo/icons/recording-start.svg"
recording_stop_icon="$HOME/.local/share/charo/icons/recording.svg"

notify() {
    # $1 = summary, $2 = body, $3 = icon, $4 = urgency
    if [ -t 1 ]; then
        printf '%s\n' "$1${2:+ - $2}"
        return
    fi
    command -v notify-send >/dev/null 2>&1 || return 0
    notify-send -a Charo -u "${4:-normal}" -i "${3:-audio-input-microphone}" \
        -h string:x-canonical-private-synchronous:charo \
        "$1" "${2:-}" 2>/dev/null || true
}

state() {
    if ! systemctl --user --quiet is-active "$service"; then
        echo off
    elif [ -e "$runtime/recording_status" ]; then
        echo recording
    else
        echo idle
    fi
}

# Turn an XFCE binding like "<Primary><Super>d" into a readable "Ctrl+Super+D".
format_combo() {
    printf '%s\n' "$1" | sed -E '
        s/<Primary>/Ctrl+/g
        s/<Control>/Ctrl+/g
        s/<Super>/Super+/g
        s/<Shift>/Shift+/g
        s/<Alt>/Alt+/g
        s/(^|\+)([[:alpha:]])([[:alpha:]]*)$/\1\U\2\E\3/
    '
}

# The readable key combo XFCE runs for a given charo action, or empty if unbound.
key_for() {
    line=$(xfconf-query -c xfce4-keyboard-shortcuts -p /commands/custom -lv 2>/dev/null \
        | grep -E "/charo $1\$" | head -n1)
    [ -z "$line" ] && return
    format_combo "$(basename "$(printf '%s\n' "$line" | awk '{print $1}')")"
}

# Every charo shortcut as "combo<TAB>description" lines, for the tray and help.
list_keys() {
    for spec in \
        "record:dictate (press again to stop)" \
        "engine switch:switch engine" \
        "power:load or unload the engine" \
        "tv:TV mode on/off"; do
        action=${spec%%:*}
        combo=$(key_for "$action")
        [ -n "$combo" ] && printf '%s\t%s\n' "$combo" "${spec#*:}"
    done
}

# Engine identifiers as hyprwhspr writes them, and the names we show.
engine_id() {
    case "$1" in
        parakeet|onnx-asr|onnx) echo onnx-asr ;;
        whisper|faster-whisper|fw) echo faster-whisper ;;
        *) echo "" ;;
    esac
}

engine_name() {
    case "$1" in
        onnx-asr) echo "Parakeet (auto, 25 languages)" ;;
        faster-whisper) echo "Whisper (99 languages, adds Catalan)" ;;
        *) echo "$1" ;;
    esac
}

engine_current() {
    python3 - "$config" <<'PY'
import json, sys
try:
    with open(sys.argv[1]) as handle:
        print(json.load(handle).get("transcription_backend", "unknown"))
except Exception:
    print("unknown")
PY
}

# Rewrite only transcription_backend, preserving every other setting, the file
# mode, and a restorable copy of the previous configuration.
engine_write() {
    python3 - "$config" "$1" <<'PY'
import json, os, shutil, sys

path, target = sys.argv[1], sys.argv[2]
with open(path) as handle:
    config = json.load(handle)

if config.get("transcription_backend") == target:
    print("unchanged")
    raise SystemExit(0)

shutil.copy2(path, path + ".pre-engine-switch")
config["transcription_backend"] = target

tmp = path + ".engine-switch.tmp"
with open(tmp, "w") as handle:
    json.dump(config, handle, indent=4)
    handle.write("\n")
os.chmod(tmp, 0o600)
os.replace(tmp, path)
print("switched")
PY
}

engine_set() {
    target=$(engine_id "$1")
    if [ -z "$target" ]; then
        printf 'charo: unknown engine "%s" (parakeet | whisper)\n' "$1" >&2
        exit 2
    fi

    label=$(engine_name "$target")
    if [ "$(engine_write "$target")" = unchanged ]; then
        notify "Already using $label" "" audio-input-microphone
        return 0
    fi

    # A loaded engine keeps serving the old model until it is restarted.
    if [ "$(state)" != off ]; then
        systemctl --user restart "$service"
        notify "Switched to $label" "Reloading the speech model" audio-input-microphone
    else
        notify "Switched to $label" "Takes effect at the next dictation" audio-input-microphone
    fi
}

# TV mode is derived from the live config: no start phrase and no aliases means
# nothing is listening for a spoken trigger.
tv_current() {
    python3 - "$config" <<'PY'
import json, sys
try:
    with open(sys.argv[1]) as handle:
        config = json.load(handle)
except Exception:
    print("unknown")
    raise SystemExit(0)

phrase = str(config.get("voice_start_phrase") or "").strip()
aliases = [str(a).strip() for a in (config.get("voice_start_aliases") or []) if str(a).strip()]
print("off" if (phrase or aliases) else "on")
PY
}

tv_write() {
    python3 - "$config" "$wakewords" "$1" <<'PY'
import json, os, shutil, sys

config_path, saved_path, action = sys.argv[1], sys.argv[2], sys.argv[3]
with open(config_path) as handle:
    config = json.load(handle)

phrase = str(config.get("voice_start_phrase") or "").strip()
aliases = [str(a).strip() for a in (config.get("voice_start_aliases") or []) if str(a).strip()]
listening = bool(phrase or aliases)

if action == "on":
    if not listening:
        print("unchanged")
        raise SystemExit(0)
    os.makedirs(os.path.dirname(saved_path), exist_ok=True)
    with open(saved_path, "w") as handle:
        json.dump(
            {
                "voice_start_phrase": config.get("voice_start_phrase", ""),
                "voice_start_aliases": config.get("voice_start_aliases", []),
            },
            handle,
            indent=2,
        )
    config["voice_start_phrase"] = ""
    config["voice_start_aliases"] = []
else:
    if listening:
        print("unchanged")
        raise SystemExit(0)
    try:
        with open(saved_path) as handle:
            saved = json.load(handle)
    except Exception:
        print("nosaved")
        raise SystemExit(0)
    restored_phrase = saved.get("voice_start_phrase", "")
    restored_aliases = saved.get("voice_start_aliases", [])
    if not (str(restored_phrase).strip() or restored_aliases):
        print("nosaved")
        raise SystemExit(0)
    config["voice_start_phrase"] = restored_phrase
    config["voice_start_aliases"] = restored_aliases

shutil.copy2(config_path, config_path + ".pre-tv-mode")
tmp = config_path + ".tv-mode.tmp"
with open(tmp, "w") as handle:
    json.dump(config, handle, indent=4)
    handle.write("\n")
os.chmod(tmp, 0o600)
os.replace(tmp, config_path)
print("changed")
PY
}

tv_set() {
    case "$(tv_write "$1")" in
        unchanged)
            if [ "$1" = on ]; then
                notify "TV mode already on" "Wake words are already parked" video-display
            else
                notify "TV mode already off" "Wake words are active" audio-input-microphone
            fi
            ;;
        nosaved)
            notify "No saved wake words to restore" \
                "Set voice_start_phrase with: hyprwhspr config edit" dialog-error
            exit 1
            ;;
        changed)
            if [ "$(state)" != off ]; then
                systemctl --user restart "$service"
            fi
            if [ "$1" = on ]; then
                notify "TV mode on" "Wake words parked - dictate with Super+D only" video-display
            else
                notify "TV mode off" "Wake words listening again" audio-input-microphone
            fi
            ;;
    esac
}

# The engine may still be loading its model, so retry until it answers.
record_toggle() {
    if ! systemctl --user --quiet is-active "$service"; then
        systemctl --user start "$service"
    fi

    i=0
    while [ "$i" -lt 120 ]; do
        output=$("$hyprwhspr" record toggle 2>&1) || true
        case "$output" in
            *'[SUCCESS]'*) return 0 ;;
        esac
        sleep 0.25
        i=$((i + 1))
    done
    return 1
}

cmd=${1:-status}
[ $# -gt 0 ] && shift

case "$cmd" in
    state)
        state
        ;;
    status)
        printf 'Engine:  %s\n' "$(engine_name "$(engine_current)")"
        printf 'TV mode: %s\n' "$(tv_current)"
        printf 'State:   %s\n' "$(state)"
        keys_out=$(list_keys)
        if [ -n "$keys_out" ]; then
            printf 'Keys:\n'
            printf '%s\n' "$keys_out" | while IFS="$(printf '\t')" read -r combo label; do
                printf '  %-14s %s\n' "$combo" "$label"
            done
        fi
        if [ "$(state)" != off ]; then
            "$hyprwhspr" record status
        fi
        ;;
    keys)
        keys_out=$(list_keys)
        if [ -z "$keys_out" ]; then
            printf 'No charo shortcuts are set. Run charo-setup to bind them.\n'
            exit 1
        fi
        printf '%s\n' "$keys_out" | while IFS="$(printf '\t')" read -r combo label; do
            printf '%-14s %s\n' "$combo" "$label"
        done
        ;;
    engine)
        case "${1:-show}" in
            show) engine_name "$(engine_current)" ;;
            id)   engine_current ;;
            switch|toggle)
                if [ "$(engine_current)" = onnx-asr ]; then
                    engine_set whisper
                else
                    engine_set parakeet
                fi
                ;;
            *) engine_set "$1" ;;
        esac
        ;;
    tv)
        case "${1:-toggle}" in
            status|show) tv_current ;;
            on|off) tv_set "$1" ;;
            toggle)
                if [ "$(tv_current)" = on ]; then
                    tv_set off
                else
                    tv_set on
                fi
                ;;
            *)
                printf 'charo: tv takes on, off, toggle or status\n' >&2
                exit 2
                ;;
        esac
        ;;
    on)
        if [ "$(state)" = off ]; then
            systemctl --user start "$service"
            notify "Dictation starting" "Loading $(engine_name "$(engine_current)")" audio-input-microphone
        else
            notify "Dictation already on" "" audio-input-microphone
        fi
        ;;
    off)
        if [ "$(state)" = off ]; then
            notify "Dictation already off" "" microphone-sensitivity-muted
        else
            systemctl --user stop "$service"
            notify "Dictation off" "Memory released" microphone-sensitivity-muted
        fi
        ;;
    power)
        if [ "$(state)" = off ]; then
            "$0" on
        else
            "$0" off
        fi
        ;;
    record)
        if [ "$(state)" = off ]; then
            notify "Dictation starting" "Recording begins once the model is loaded" audio-input-microphone
        fi
        if record_toggle; then
            if [ "$(state)" = recording ]; then
                stopkey=$(key_for record)
                notify "Recording started" \
                    "Speak now - press ${stopkey:-your dictation key} again to stop" "$recording_start_icon" low
            else
                notify "Recording stopped" "Transcribing and inserting text" "$recording_stop_icon" critical
            fi
        else
            notify "Dictation did not respond" \
                "Check: journalctl --user -u hyprwhspr-on-demand -n 50" dialog-error
            exit 1
        fi
        ;;
    -h|--help|help)
        sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//'
        ;;
    *)
        printf 'charo: unknown command "%s" (try --help)\n' "$cmd" >&2
        exit 2
        ;;
esac
