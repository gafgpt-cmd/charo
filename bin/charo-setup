#!/bin/sh
# charo-setup - check dependencies and wire charo into the desktop.
#
#   charo-setup            apply the setup
#   charo-setup --check    report only, change nothing
#
# Safe to run repeatedly: it only changes what is missing or wrong, and reports
# what it cannot fix. install.sh runs this after putting the files in place.
set -eu

check_only=0
[ "${1:-}" = "--check" ] && check_only=1

bindir="$HOME/.local/bin"
hyprwhspr="$HOME/.local/share/hyprwhspr/src/bin/hyprwhspr"
autostart="$HOME/.config/autostart/charo-indicator.desktop"
icons="$HOME/.local/share/charo/icons"
problems=0

ok()  { printf '  ok      %s\n' "$1"; }
did() { printf '  applied %s\n' "$1"; }
bad() { printf '  MISSING %s\n' "$1"; problems=$((problems + 1)); }

printf 'Dependencies\n'
for cmd in systemctl xfconf-query python3 xclip notify-send; do
    if command -v "$cmd" >/dev/null 2>&1; then
        ok "$cmd"
    else
        bad "$cmd - install it through your package manager"
    fi
done

if [ -x "$hyprwhspr" ]; then
    ok "hyprwhspr"
else
    bad "hyprwhspr at $hyprwhspr - see https://github.com/goodroot/hyprwhspr"
fi

if python3 -c "import gi; gi.require_version('Gtk', '3.0'); from gi.repository import Gtk" 2>/dev/null; then
    ok "python3 gtk bindings"
else
    bad "python3 gtk bindings - install python3-gi and gir1.2-gtk-3.0"
fi

printf '\nInstalled files\n'
for file in charo charo-indicator charo-setup; do
    if [ -x "$bindir/$file" ]; then
        ok "$bindir/$file"
    else
        bad "$bindir/$file - run install.sh from the charo checkout"
    fi
done

if [ -d "$icons" ] && [ -n "$(ls -A "$icons" 2>/dev/null)" ]; then
    ok "tray icons"
else
    bad "tray icons in $icons - run install.sh"
fi

printf '\nKeyboard shortcuts\n'
# Each entry is "<xfce binding>|<command>".
set -- \
    "<Super>d|$bindir/charo record" \
    "<Shift><Super>d|$bindir/charo power" \
    "<Primary><Super>d|$bindir/charo engine switch" \
    "<Super>t|$bindir/charo tv"

for entry in "$@"; do
    key=${entry%%|*}
    cmd=${entry#*|}
    current=$(xfconf-query -c xfce4-keyboard-shortcuts -p "/commands/custom/$key" 2>/dev/null || true)
    if [ "$current" = "$cmd" ]; then
        ok "$key"
    elif [ "$check_only" -eq 1 ]; then
        bad "$key -> $cmd"
    else
        xfconf-query -c xfce4-keyboard-shortcuts -p "/commands/custom/$key" \
            --create -t string -s "$cmd"
        did "$key -> $cmd"
    fi
done

printf '\nTray indicator\n'
if [ -f "$autostart" ]; then
    ok "starts at login"
elif [ "$check_only" -eq 1 ]; then
    bad "autostart entry $autostart"
else
    mkdir -p "$(dirname "$autostart")"
    cat >"$autostart" <<EOF
[Desktop Entry]
Type=Application
Name=Charo
Comment=Dictation tray control for hyprwhspr
Exec=$bindir/charo-indicator
Icon=audio-input-microphone
Terminal=false
X-GNOME-Autostart-enabled=true
EOF
    did "autostart entry"
fi

if pgrep -f "bin/charo-indicato[r]" >/dev/null 2>&1; then
    ok "running now"
elif [ "$check_only" -eq 1 ]; then
    bad "not running - start it with charo-indicator"
else
    systemd-run --user --unit=charo-indicator \
        --description="Charo dictation tray" "$bindir/charo-indicator" >/dev/null 2>&1
    did "started"
fi

printf '\n'
if [ "$problems" -eq 0 ]; then
    printf 'Charo is ready. Super+D dictates; see charo --help.\n'
else
    printf '%d item(s) need attention.\n' "$problems"
    exit 1
fi
